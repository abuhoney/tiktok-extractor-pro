# ============================================================
# TikTok Extractor Pro — Environment template
# Copy to .env and fill in your values.
# ============================================================

# Server
HOST=0.0.0.0
PORT=10000
NODE_ENV=production
BACKEND_SECRET=change-me-to-a-random-string

# Optional: HTTP or SOCKS5 proxy to bypass geo-blocks
# (e.g. http://user:pass@host:port or socks5://host:port)
TIKTOK_PROXY=

# Optional: enable headless browser X-Bogus signer
ENABLE_PLAYWRIGHT=false

# Optional: Telegram bot integration (for remote extraction via DM)
API_ID=
API_HASH=
BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
BOT_USERNAME=

# Optional: Firebase for usage stats storage
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
