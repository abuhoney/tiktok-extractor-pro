<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07070d">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#ff2d55" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/errorView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="تعذّر تحميل التطبيق.\n\nتأكد من اتصالك بالإنترنت ثم أعد فتح التطبيق."
                android:textColor="#ff4d6d"
                android:textSize="16sp"
                android:visibility="gone" />

        </FrameLayout>
    </LinearLayout>

    <!-- زر مراقبة قاعدة البيانات العائم (FAB) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDatabase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_margin="20dp"
        android:src="@android:drawable/ic_menu_sort_by_size"
        android:backgroundTint="#25f4ee"
        android:contentDescription="مراقبة قاعدة البيانات"
        android:tint="#000000"
        app:borderWidth="0dp"
        app:elevation="8dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- زر التفاعل التلقائي العائم (FAB) - ثانوي -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabInteract"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_margin="20dp"
        android:layout_marginBottom="84dp"
        android:src="@android:drawable/ic_menu_send"
        android:backgroundTint="#ff2d55"
        android:contentDescription="تفاعل تلقائي"
        android:tint="#ffffff"
        android:visibility="visible"
        app:borderWidth="0dp"
        app:elevation="8dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</FrameLayout>
